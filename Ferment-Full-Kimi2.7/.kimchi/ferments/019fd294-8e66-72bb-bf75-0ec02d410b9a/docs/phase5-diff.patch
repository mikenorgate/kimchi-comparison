+import { render, screen, within } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { describe, expect, it, beforeEach } from 'vitest'
+import { Photos } from './Photos'
+
+describe('Photos', () => {
+  beforeEach(() => {
+    render(<Photos />)
